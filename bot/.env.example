# ===== Bot-Member-Zalo — cấu hình =====
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# --- Group ---
# ID của group Zalo cần quản lý (lấy bằng lệnh `npm run list-groups`).
GROUP_ID=

# Số thành viên muốn giữ lại sau mỗi kỳ dọn dẹp (brainstorm: 965).
TARGET_MEMBER_COUNT=965

# --- Lưu trữ ---
# Đường dẫn file SQLite (đĩa persistent trên VPS).
SQLITE_DB_PATH=./data/bot.db

# Thư mục lưu session đăng nhập Zalo (cookie/imei). KHÔNG commit.
SESSION_DIR=./data

# --- Làm nóng (warmup) ---
# Số ngày bot chỉ quan sát, chưa kick (brainstorm: 30 ngày).
WARMUP_DAYS=30

# --- An toàn ---
# 1 = dry-run (không gửi cảnh báo/kick thật). Để 1 khi test danh sách.
DRY_RUN=1

# Nghỉ giữa mỗi lần gọi Zalo nặng (ms) — chống bị flag (đọc member/poll).
ZALO_THROTTLE_MS=1500

# In heartbeat để biết listener còn sống. 0 = tắt.
LISTENER_HEARTBEAT_MS=60000

# Chủ động sync danh sách member trong listener mỗi N ms. 0 = tắt sync chủ động.
# Mặc định 30 phút: đủ để sửa lệch khi admin xóa tay hoặc WebSocket rớt group_event.
LISTENER_MEMBER_SYNC_INTERVAL_MS=1800000

# Log mỗi N event message/reaction nhận được. 1 = log từng event, 0 = tắt.
LISTENER_EVENT_LOG_EVERY=1

# 1 = listener cũng nhận event do chính tài khoản bot gửi để lưu text message.
# Self-message cũng được ghi interaction và tính vào ranking cleanup.
ZALO_SELF_LISTEN=1

# Trần số member xoá trong một kỳ cleanup.
MAX_KICKS_PER_RUN=50

# Nghỉ giữa mỗi lần kick thật (ms). Brainstorm: 2 phút.
KICK_THROTTLE_MS=120000

# File JSON danh sách trắng: [] hoặc [{"id":"zalo_user_id","note":"VIP"}].
VIP_LIST_PATH=./data/vip-list.json

# 1 = cho phép `npm run cleanup-warn` gửi cảnh báo vào group khi DRY_RUN=0.
SEND_GROUP_WARNINGS=0

# --- Telegram approval (Milestone 2) ---
# Tạo bot qua @BotFather, lấy token; lấy chat id admin rồi điền vào đây.
# Khi hai biến này có giá trị và DRY_RUN=0, monthly-cleanup sẽ gửi danh sách chờ duyệt.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Forward tin Zalo sang Telegram ---
# 1 = sao chép tin nhắn live từ GROUP_ID sang đích Telegram bên dưới.
TELEGRAM_FORWARD_ENABLED=0

# Token của bot RIÊNG cho luồng forward. Không dùng chung TELEGRAM_BOT_TOKEN notification.
TELEGRAM_FORWARD_BOT_TOKEN=

# Supergroup/forum: ID dạng -100...; channel public có thể dùng @channel_username.
# Bot phải là thành viên và có quyền gửi tin tại đích.
TELEGRAM_FORWARD_CHAT_ID=

# Nếu đích là một topic trong forum group, điền message_thread_id của topic.
# Nếu là channel hoặc chat thường thì để trống.
TELEGRAM_FORWARD_TOPIC_ID=

# Không phản hồi sau N giờ thì telegram-poll tự động chạy cleanup.
APPROVAL_TIMEOUT_HOURS=48

# --- Tóm tắt hằng ngày (cron 9:10 sáng, tóm tắt ngày hôm trước) ---
# Các group Zalo nhận bản tóm tắt, phân tách dấu phẩy (ID lấy bằng `npm run list-groups`).
# Có thể gồm cả GROUP_ID để gửi ngược về nhóm chính. Ví dụ: SUMMARY_GROUP_ID=111,222
# Tài khoản bot phải là thành viên mọi group liệt kê. Rỗng = không gửi Zalo.
SUMMARY_GROUP_ID=

# Chat/channel Telegram nhận thêm bản tóm tắt (vd @tenchannel, hoặc -100xxxx với
# channel private). Bot Telegram phải là ADMIN có quyền gửi tin ở đó. Rỗng = không gửi.
SUMMARY_TELEGRAM_CHAT_ID=

# message_thread_id nếu đích Telegram là topic trong forum group. Thường để trống.
SUMMARY_TELEGRAM_TOPIC_ID=

# Bot token riêng cho đích Telegram trên (nếu channel dùng bot khác).
# Để trống = dùng chung TELEGRAM_BOT_TOKEN.
SUMMARY_TELEGRAM_BOT_TOKEN=

# API key DeepSeek (https://platform.deepseek.com) để tóm tắt nội dung.
DEEPSEEK_API_KEY=

# Model DeepSeek. deepseek-v4-flash: nhanh/rẻ, hiểu ngữ cảnh hội thoại tốt;
# nâng lên deepseek-v4-pro nếu muốn tóm tắt sâu hơn nữa.
DEEPSEEK_MODEL=deepseek-v4-flash

# Số tin nhắn Zalo tối đa cho một bản tóm tắt (1-9). Số tin thực tế tự co giãn
# theo nội dung (ngày ít chat = 1 tin); tăng số này nếu muốn ngày sôi động được
# tóm tắt chi tiết hơn thay vì nén ngắn.
SUMMARY_MAX_PARTS=3

# Giãn cách giữa các group Zalo khi gửi (phút, kèm jitter +0-25%) — tránh cùng
# một bản tin xuất hiện ở nhiều group cùng lúc, trông rất "bot". 0 = gửi liền.
SUMMARY_GROUP_GAP_MINUTES=10

# ===== Bản tin Facebook Page (daily-fb-post, cron 8:00 sáng) =====
# Page nhận bản tin public hằng ngày. Để trống CẢ HAI = tắt tính năng.
# FB_PAGE_TOKEN là Page token KHÔNG hết hạn: Graph API Explorer lấy user token
# (pages_show_list + pages_read_engagement + pages_manage_posts) -> đổi dài hạn
# qua /oauth/access_token -> lấy Page token từ /me/accounts.
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Sinh ảnh minh họa — tầng ưu tiên: endpoint OpenAI-compatible bất kỳ
# (cùng cơ chế BLOG_IMAGE_* bên ai4ba, vd https://api.bahub.vn/v1 + cx/gpt-5.5-image).
FB_IMAGE_BASE_URL=
FB_IMAGE_API_KEY=
FB_IMAGE_MODEL=

# Tầng dự phòng: Beeknoee (https://platform.beeknoee.com, key dạng sk-bee-...,
# tài khoản cần số dư >= 15.000đ để mở model). Cả 2 tầng lỗi -> dùng ảnh card mẫu.
BEEKNOEE_API_KEY=

# --- Ảnh bản tin cho bahub.vn/ban-tin ---
# Bot ghi thêm bản WebP nhẹ (1200px) của mỗi ảnh vào thư mục dưới đây để nginx
# serve thẳng; card trên bahub.vn nhúng URL đó.
#
# BULLETIN_IMAGE_BASE_URL để TRỐNG = không xuất ảnh ra web (bản tin vẫn đăng
# Facebook và vẫn lên bahub.vn, chỉ là card không ảnh). Chỉ điền SAU KHI đã
# thêm block `location ^~ /bt/` vào nginx — xem deploy/nginx-bahub.conf.example.
BULLETIN_IMAGE_DIR=./data/public/bt
BULLETIN_IMAGE_BASE_URL=

# --- Web dashboard ---
# Đổi nếu VPS đã có ứng dụng dùng port 3000.
WEB_PORT=5831

# Domain public thật của dashboard nếu chạy qua nginx reverse proxy (vd https://bot.example.com).
# BẮT BUỘC điền nếu dùng domain — nếu bỏ trống, các API POST (kick, sync, đăng nhập lại...)
# tự so Origin với Host mà Next.js thấy được, dễ sai lệch sau reverse proxy → lỗi
# "Origin không hợp lệ" dù bấm đúng từ dashboard thật. Nhiều domain thì phân tách bởi dấu phẩy.
PUBLIC_ORIGIN=

# Subdomain public chỉ hiển thị leaderboard, không gồm protocol/đường dẫn.
# Ví dụ: leaderboard.bahub.vn
PUBLIC_LEADERBOARD_HOST=

# --- Sync lên bahub.vn ---
# Hai lệnh cron dùng chung cặp biến này:
#   `npm run sync-leaderboard` (30 phút/lần) → site_settings.zalo_leaderboard
#      → hiện ở bahub.vn/leaderboard
#   `npm run sync-posts` (mỗi giờ, 9h-23h) → bảng zalo_bulletin_posts
#      → hiện ở bahub.vn/ban-tin (trang CÔNG KHAI, có index SEO). Chỉ đẩy BẢN
#      PUBLIC đã lược tên thành viên — bản tóm tắt nội bộ không rời VPS.
# URL project Supabase, ví dụ: https://xxxx.supabase.co
SUPABASE_URL=

# Service role key (Supabase dashboard → Settings → API). BÍ MẬT — không commit,
# chỉ nằm trong .env trên VPS. Rỗng = ba lệnh sync báo lỗi, không sync.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tin tuyển dụng (daily-jobs → bahub.vn/tuyen-dung) ---
# Bot gom tin từ ba nguồn, cho DeepSeek lọc + bóc tách, rồi đẩy lên
# bahub.vn/tuyen-dung bằng `npm run sync-jobs`. Không cấu hình nguồn nào =
# tính năng TẮT hoàn toàn.

# Slug group Facebook CÔNG KHAI (phần sau facebook.com/groups/). Ví dụ: bahubvn
# Group phải để chế độ Công khai — group riêng tư thì không lấy được, vì Meta đã
# gỡ Groups API khỏi mọi phiên bản từ 22/04/2024. Rỗng = tắt nguồn Facebook.
JOB_FB_GROUP_SLUG=

# User-Agent dùng khi tải trang group. Facebook chỉ trả bản server-render đầy đủ
# (~30 bài, ~11 ngày) cho UA của bot công cụ tìm kiếm; UA trình duyệt chỉ được 2
# bài. Để trống = dùng mặc định trong config.ts (UA Googlebot).
JOB_FB_USER_AGENT=

# Proxy TRẢ PHÍ để đọc group Facebook. Nhiều con ngăn nhau bằng dấu phẩy hoặc
# xuống dòng; nhận cả http://user:pass@host:port lẫn host:port:user:pass.
#
# Vì sao cần: Facebook vẫn phục vụ group công khai cho khách chưa đăng nhập,
# nhưng chỉ với IP chưa bị đánh dấu — và IP trung tâm dữ liệu của VPS gần như
# luôn đã bị đánh dấu, bị đá thẳng về /login và KHÔNG tự hồi.
#
# ĐÃ ĐO 14/08/2026: proxy datacenter dùng chung (Webshare gói free) 0/10 con đọc
# được — pool đó bị scrape nhiều nên cháy sạch. Muốn chắc ăn thì mua residential
# (IPRoyal ~$7/GB, traffic không hết hạn); mỗi lần lấy chỉ tốn ~0,53 MB nên 1 GB
# đủ dùng khoảng 5 năm ở nhịp 1 lần/ngày. Rỗng = bỏ qua nấc này.
JOB_FB_PROXIES=

# Số lần thử mỗi proxy trả phí trong một lần chạy. Trống = 3.
# >1 chỉ có ý nghĩa với residential XOAY VÒNG (IPRoyal): mỗi lần gọi là một IP
# thoát khác nên gọi lại là bốc IP mới. Lần bị chặn chỉ tốn phản hồi 302 vài
# trăm byte. Dùng proxy TĨNH (một IP cố định) thì để 1 cho nhanh.
JOB_FB_PROXY_ATTEMPTS=

# 1 = khi mọi đường trên đều hỏng thì dò danh sách proxy công cộng miễn phí.
# Đo thực tế: ~4/60 con đọc được đủ bài, một lần dò mất ~80 giây. Đủ dùng cho
# nhịp 1 lần/ngày, nhưng không có gì bảo đảm — đó là lý do vẫn nên có proxy trả phí.
JOB_FB_FREE_PROXY_ENABLED=1

# Nguồn danh sách proxy miễn phí (mỗi dòng host:port). Trống = dùng mặc định
# monosans/proxy-list trên GitHub, cập nhật mỗi giờ.
JOB_FB_FREE_PROXY_URL=

# Trần số proxy miễn phí dò mỗi lần chạy. Trống = 30.
JOB_FB_FREE_PROXY_MAX_TRIES=

# Cookie phiên đăng nhập Facebook, dạng "c_user=...; xs=...". MẶC ĐỊNH ĐỂ TRỐNG.
#
# Có cookie thì tường đăng nhập biến mất kể cả trên IP bẩn, nhưng nó đặt một tài
# khoản vào rủi ro: CHỈ dùng tài khoản phụ, và nên đi kèm proxy đúng vùng — đăng
# nhập ở một nơi rồi dùng ở IP trung tâm dữ liệu là mẫu hình Facebook hay bắt
# checkpoint. Cookie hết hạn sẽ được báo riêng trong bot_errors để biết đường
# lấy lại, không lẫn với lỗi IP bị chặn.
JOB_FB_COOKIE=

# Username group Telegram CÔNG KHAI chứa tin tuyển dụng (phần sau t.me/).
# Ví dụ: businessanalystvietnam. Rỗng = tắt nguồn Telegram.
#
# Đọc qua Post Widget công khai (t.me/<group>/<id>?embed=1), KHÔNG dùng bot:
# getUpdates của Bot API không đọc được lịch sử và chỉ giữ update chưa đọc 24
# giờ, nên mất mạng một ngày là mất tin vĩnh viễn.
JOB_TELEGRAM_GROUP_SLUG=

# Id topic tuyển dụng (số cuối trong link topic, vd t.me/<group>/440 → 440).
# TRỐNG = lấy MỌI topic — cẩn thận: nếu group có topic nhận tin forward từ Zalo
# thì lấy hết sẽ trùng lặp với nguồn Zalo.
JOB_TELEGRAM_TOPIC_ID=

# 1 = lấy cả tin tuyển dụng đăng trong group Zalo chính (GROUP_ID).
# Group Zalo là group KÍN nên tin từ nguồn này không có link bài gốc công khai.
JOB_ZALO_ENABLED=1

# Cửa sổ gom tin rời (phút). Trong Zalo/Telegram người ta hay nhắn "cần tuyển BA"
# rồi tin sau mới nói lương, tin sau nữa mới nói địa điểm — các tin của cùng một
# người cách nhau dưới ngưỡng này được ghép thành MỘT tin tuyển dụng.
JOB_CLUSTER_GAP_MINUTES=15

# Lần chạy ĐẦU TIÊN lùi lại bao nhiêu ngày để lấy tin (các lần sau đi theo con trỏ).
JOB_LOOKBACK_DAYS=7

# Tin tuyển dụng tự ẩn sau bao nhiêu ngày kể từ ngày đăng gốc. Trang tuyển dụng
# đầy tin chết là thứ giết uy tín nhanh nhất.
JOB_EXPIRE_DAYS=30

# Trần số mẩu gửi cho AI mỗi lần chạy — chặn hoá đơn model tăng đột biến khi
# nguồn bỗng nhiên đổ về hàng trăm bài. Phần dư chạy tiếp ở lần sau.
JOB_MAX_ITEMS_PER_RUN=60
